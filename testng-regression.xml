<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ============================================================
  Regression Suite – Phase 7: CI/CD Integration
  ============================================================
  Purpose  : Full regression coverage across all test classes.
             Runs in parallel with higher thread count for speed.
  Execution: mvn test -DsuiteFile=testng-regression.xml
  Duration : ~10-15 minutes target
  ============================================================
-->
<suite name="SauceDemo Regression Suite" parallel="classes" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="com.saucedemo.listeners.TestListener"/>
        <listener class-name="com.saucedemo.listeners.AnnotationTransformer"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <test name="Regression - Login">
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Regression - Data Driven Login">
        <classes>
            <class name="com.saucedemo.tests.DataDrivenLoginTest"/>
        </classes>
    </test>

    <test name="Regression - Inventory">
        <classes>
            <class name="com.saucedemo.tests.InventoryTest"/>
        </classes>
    </test>

    <test name="Regression - Cart">
        <classes>
            <class name="com.saucedemo.tests.CartTest"/>
        </classes>
    </test>

    <test name="Regression - Checkout">
        <classes>
            <class name="com.saucedemo.tests.CheckoutTest"/>
        </classes>
    </test>

    <test name="Regression - Advanced Interactions">
        <classes>
            <class name="com.saucedemo.tests.AdvancedInteractionsTest"/>
        </classes>
    </test>

</suite>
