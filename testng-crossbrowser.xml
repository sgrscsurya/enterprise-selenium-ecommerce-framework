<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ============================================================
  Cross-Browser Suite – Phase 7
  ============================================================
  Purpose  : Runs Login + Checkout smoke scenarios across
             Chrome, Firefox, and Edge in true parallel
             (one JVM thread per <test> block).

  Execution:
    Local (3 browsers, 3 threads):
      mvn test -DsuiteFile=testng-crossbrowser.xml

    With Selenium Grid:
      mvn test -DsuiteFile=testng-crossbrowser.xml -Dgrid=true

    Single browser override:
      mvn test -DsuiteFile=testng-crossbrowser.xml -Dbrowser=firefox

  Thread model:
    parallel="tests"  → Each <test> element runs in its own thread.
    thread-count="3"  → Three browsers run simultaneously.
  ============================================================
-->
<suite name="SauceDemo Cross-Browser Suite"
       parallel="tests"
       thread-count="3"
       verbose="1">

    <listeners>
        <listener class-name="com.saucedemo.listeners.TestListener"/>
        <listener class-name="com.saucedemo.listeners.AnnotationTransformer"/>
    </listeners>

    <!-- ====================== CHROME ========================= -->
    <test name="Chrome - Login">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Chrome - Checkout">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.saucedemo.tests.CheckoutTest"/>
        </classes>
    </test>

    <!-- ====================== FIREFOX ======================== -->
    <test name="Firefox - Login">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Firefox - Checkout">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.saucedemo.tests.CheckoutTest"/>
        </classes>
    </test>

    <!-- ====================== EDGE ============================ -->
    <test name="Edge - Login">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Edge - Checkout">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.saucedemo.tests.CheckoutTest"/>
        </classes>
    </test>

</suite>
