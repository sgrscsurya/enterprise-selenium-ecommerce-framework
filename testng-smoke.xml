<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  ============================================================
  Smoke Suite – Phase 7: CI/CD Integration
  ============================================================
  Purpose  : Fast sanity check. Runs only the highest-priority
             tests that confirm core application flows work.
  Execution: mvn test -DsuiteFile=testng-smoke.xml
  Duration : ~2-3 minutes target
  ============================================================
-->
<suite name="SauceDemo Smoke Suite" parallel="classes" thread-count="1" verbose="1">

    <listeners>
        <listener class-name="com.saucedemo.listeners.TestListener"/>
        <listener class-name="com.saucedemo.listeners.AnnotationTransformer"/>
    </listeners>

    <!-- Browser can be overridden via -Dbrowser=firefox -->
    <parameter name="browser" value="chrome"/>

    <test name="Smoke - Login">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Smoke - Inventory">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.saucedemo.tests.InventoryTest"/>
        </classes>
    </test>

    <test name="Smoke - Checkout">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.saucedemo.tests.CheckoutTest"/>
        </classes>
    </test>

</suite>
